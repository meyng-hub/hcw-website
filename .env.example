# Stripe (donations)
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Email (Resend — contact & volunteer forms)
RESEND_API_KEY=re_...

# Newsletter (Brevo) — signup form is dormant until BOTH are set
BREVO_API_KEY=xkeysib-...
BREVO_LIST_ID=1

# Admin back-office
ADMIN_ALLOWED_EMAILS=you@example.com
ADMIN_SESSION_SECRET=generate_a_long_random_string
GITHUB_CONTENT_PAT=github_pat_...

# Site
NEXT_PUBLIC_SITE_URL=https://www.h-cw.org

# Analytics: Vercel Analytics + Speed Insights (cookieless).
# No env var needed — enable Web Analytics in the Vercel project dashboard.

# Google Analytics 4 (GA4) — powers Google Ads / Ad Grants conversion tracking.
# Leave UNSET to disable the Google tag entirely: no script, no consent banner,
# no cookies. Set it to the measurement ID from GA4 Admin > Data streams.
# Consent Mode v2 defaults to denied; the banner grants it.
# IMPORTANT when setting it on Vercel from the CLI, use printf, never echo —
# `echo` appends a newline that gets inlined at build time and breaks the ID:
#   printf 'G-XXXXXXXXXX' | npx vercel env add NEXT_PUBLIC_GA_ID production
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
